# Copia este archivo a .env (NO se versiona) y rellena SOLO lo que uses.
# En AWS estos valores viven en Secrets Manager, no en variables de entorno.

APP_ENV=local                 # local | dev | workshop
LOG_LEVEL=INFO

# --- Modos (todo funciona en mock sin red ni costo) ---
LLM_MODE=mock                 # mock | openai
EMBEDDING_MODE=mock           # mock | openai
STORE_MODE=memory             # memory | supabase
ACTION_QUEUE_MODE=inline      # inline | sqs
SECRETS_BACKEND=env           # env | aws

# --- OpenAI (solo si LLM_MODE/EMBEDDING_MODE=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Supabase / Postgres (solo si STORE_MODE=supabase) ---
# Lambda -> pooler en modo transaccion (puerto 6543). EC2/migraciones -> session pooler (5432).
DATABASE_URL=postgresql://postgres.gmpiblhctxucvzehvzdv:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:5432/postgres
DB_POOL_MAX=2

# --- Autenticacion JWT ---
JWT_SECRET=                   # HS256 (Supabase "JWT Secret" legacy) -- o bien:
JWT_JWKS_URL=                 # https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
JWT_ISSUER=                   # https://<ref>.supabase.co/auth/v1
JWT_AUDIENCE=authenticated

# --- MCP / acciones ---
MCP_SHARED_SECRET=            # firma cliente->servidor MCP
ACTION_QUEUE_URL=             # URL de la cola SQS (modo sqs)
AWS_REGION=us-east-1

# --- Secrets Manager (SECRETS_BACKEND=aws) ---
APP_SECRET_ID=maintenance-ai/dev/app
